# ===== Публичный адрес =====
# Домен без протокола. Caddy выпустит HTTPS автоматически.
DOMAIN=artback.example.com
SITE_ADDRESS=artback.example.com
APP_URL=https://artback.example.com

# ===== Секреты =====
POSTGRES_USER=artback
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=artback
SESSION_SECRET=change-me-64-random-hex-characters

# ===== YouTube Data API v3 =====
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ===== Google OAuth (необязательно) =====
# Если заполнено, на сайте появится вход через Google.
# Redirect URI: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Внешний S3 (AWS, Cloudflare R2, MinIO и т.д.) =====
# Для AWS endpoint можно оставить пустым.
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_REGION=eu-central-1
S3_BUCKET=artback-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ===== Лимиты =====
MAX_MEMBERS=100
MAX_IMAGE_MB=8
MAX_VIDEO_MB=50
MAX_AUDIO_MB=15
MAX_FILE_MB=10

# ===== Расписание (UTC) =====
# По умолчанию ежедневно в 03:17 UTC
SYNC_CRON=17 3 * * *
